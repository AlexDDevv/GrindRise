{
  "name": "grindrise",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "Outillage transverse au monorepo — la CLI Supabase, dont les migrations vivent à la racine. Ce n'est pas un workspace pnpm : mobile/ et backend/ restent installés indépendamment.",
  "scripts": {
    "db": "supabase",
    "db:start": "supabase start",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:test": "node --test \"supabase/tests/**/*.test.mjs\"",
    "db:types": "supabase gen types typescript --linked > supabase/database.types.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "supabase": "2.113.0"
  }
}
