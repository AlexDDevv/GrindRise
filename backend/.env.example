# Copier vers .env (non commité).
# Ces valeurs ne sont JAMAIS exposées au mobile.
#
# Il y a DEUX environnements, production et test, dont les valeurs ne se
# mélangent pas : un .env qui panache les deux donne un 401 sur chaque requête
# authentifiée, sans que rien ne l'explique. Garder un bloc par environnement,
# un seul actif. La liste qui fait foi est dans DEPLOIEMENT.md, section
# « Variables d'environnement ».

PORT=3000

# Projet Supabase (Settings > API), champ « Project URL ».
# URL nue, sans suffixe de chemin : le client ajoute lui-même /rest/v1, /auth/v1…
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé service_role : contourne la RLS. À traiter comme un mot de passe root.
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé du webhook RevenueCat (dashboard RevenueCat → Webhooks →
# Authorization header). Sans lui, POST /webhooks/revenuecat répond 501 : la
# route refuse de s'ouvrir plutôt que d'écrire les droits payants sans garde.
REVENUECAT_WEBHOOK_SECRET=

# Queue de notifications (service grindrise-notifications, dépôt séparé).
# Optionnelle : absente, aucune notification n'est produite et l'API le signale
# au démarrage. En production CapRover :
# redis://:<mot-de-passe>@srv-captain--redis:6379
REDIS_URL=
# Optionnel, défaut « notifications ». Doit correspondre au service worker.
NOTIFICATIONS_QUEUE_NAME=

# Désabonnement des emails de palier. Ces deux variables deviennent REQUISES
# dès que REDIS_URL est renseignée : un email de palier doit porter un lien de
# désabonnement, sinon l'API refuse de démarrer.
#
# Clé de signature des liens, 32 caractères minimum. En générer une :
#   openssl rand -base64 48
# La changer invalide tous les liens déjà envoyés — secret durable, pas une
# valeur qu'on fait tourner.
UNSUBSCRIBE_TOKEN_SECRET=
# URL publique de l'API, sans barre finale : l'API ne peut pas la deviner,
# derrière un proxy elle ne voit que son port interne.
PUBLIC_API_URL=https://api.apps.grindrise.fr

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules et sans barre finale. Vide = aucune : le mobile natif n'envoie pas
# d'en-tête Origin, il n'est donc pas concerné. Le joker « * » est refusé au
# démarrage. Exemple pour un dashboard web en développement :
# CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=
