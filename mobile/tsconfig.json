{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 n'inclut plus les paquets @types ambiants sans le dire :
    // sans cette ligne, `describe`/`it`/`expect` restent introuvables dans les
    // fichiers de test, alors que Jest les exécute très bien.
    "types": ["jest"]
  }
}
